DATABASE_URL=postgresql://ohfome_app:<senha-da-role-ohfome_app>@127.0.0.1:5432/ohfome
SESSION_SECRET=<string-aleatoria-com-32-caracteres-ou-mais>
# Opcional: habilite somente se o proxy de borda sobrescrever X-Real-IP e
# impedir acesso direto ao container. X-Forwarded-For nunca é confiado.
OHFOME_TRUST_X_REAL_IP=false
# Canal exibido em /privacidade para solicitações dirigidas ao OhFome.
PRIVACY_CONTACT_EMAIL=
# Usado por GET /api/integracoes/gestao/clientes (Authorization: Bearer <valor>).
# Compartilhe esse valor apenas com o sistema de gestao que vai consumir a API.
OHFOME_GESTAO_SYNC_SECRET=<string-aleatoria-com-32-caracteres-ou-mais>

# Domínio-base dos cardápios públicos. No Easypanel, use ohfome.app.
# Ex.: pizzaria-da-ana.ohfome.app
NEXT_PUBLIC_CARDAPIO_DOMINIO=ohfome.app

# Usado por POST /api/produtos/importar-cardapio (leitura automática de fotos
# de cardápio em Estoque & Preços). Sem isso, o botão "Importar do cardápio"
# mostra um erro claro em vez de quebrar. Chave em https://console.anthropic.com.
ANTHROPIC_API_KEY=<chave-da-api-anthropic>
# Opcional — modelo usado na leitura do cardápio. Padrão: claude-sonnet-5.
# ANTHROPIC_MODEL_CARDAPIO=claude-sonnet-5
